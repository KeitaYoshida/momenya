{
  "compilerOptions": {
    "target": "esnext",
    "baseUrl": "./",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "preserve",
    "paths": {
      "src/*": ["src/*"],
      "src/": ["src/"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "public", ".cache"]
}
