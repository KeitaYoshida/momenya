  "dependencies": {
    "@fontsource/noto-serif-jp": "^4.5.11",
    "@fortawesome/fontawesome-svg-core": "6.1.2",
    "@fortawesome/free-brands-svg-icons": "6.1.2",
    "@fortawesome/free-solid-svg-icons": "6.1.2",
    "@fortawesome/react-fontawesome": "0.2.0",
    "animate.css": "4.1.1",
    "bootstrap": "^5.2.0",
    "emergence.js": "1.1.2",
    "filters.css": "^1.0.0",
    "font-awesome": "4.7.0",
    "framer-motion": "^7.2.1",
    "gatsby": "^4.21.1",
    "gatsby-image": "3.7.1",
    "gatsby-link": "4.21.0",
    "gatsby-plugin-canonical-urls": "^4.21.0",
    "gatsby-plugin-catch-links": "4.21.0",
    "gatsby-plugin-google-adsense": "^1.1.3",
    "gatsby-plugin-google-analytics": "^4.21.0",
    "gatsby-plugin-htaccess": "^1.4.0",
    "gatsby-plugin-image": "^2.21.0",
    "gatsby-plugin-manifest": "4.21.0",
    "gatsby-plugin-netlify": "5.0.1",
    "gatsby-plugin-nprogress": "^4.21.0",
    "gatsby-plugin-offline": "5.21.0",
    "gatsby-plugin-react-helmet": "5.21.0",
    "gatsby-plugin-robots-txt": "^1.7.1",
    "gatsby-plugin-sass": "^5.21.0",
    "gatsby-plugin-sharp": "^4.21.0",
    "gatsby-plugin-sitemap": "^5.21.0",
    "gatsby-plugin-twitter": "4.21.0",
    "gatsby-plugin-typegen": "^3.0.0",
    "gatsby-plugin-typescript": "^4.21.0",
    "gatsby-remark-copy-linked-files": "5.21.0",
    "gatsby-remark-images": "6.21.0",
    "gatsby-remark-prismjs": "6.21.0",
    "gatsby-remark-responsive-iframe": "5.21.0",
    "gatsby-remark-smartypants": "5.21.0",
    "gatsby-source-filesystem": "^4.21.1",
    "gatsby-transformer-remark": "5.21.0",
    "gatsby-transformer-sharp": "^4.21.0",
    "got": "^12.3.1",
    "jquery": "3.6.0",
    "modern-normalize": "1.1.0",
    "popper.js": "1.16.1",
    "postcss": "^8.4.16",
    "prismjs": "1.29.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "6.1.0",
    "react-intersection-observer": "^9.4.0",
    "react-slick": "^0.29.0",
    "sharp": "^0.30.7",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@types/react-helmet": "6.1.5",
    "@typescript-eslint/eslint-plugin": "5.35.1",
    "@typescript-eslint/parser": "5.35.1",
    "babel-eslint": "10.1.0",
    "eslint": "8.22.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.31.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "gh-pages": "^4.0.0",
    "husky": "8.0.1",
    "lint-staged": "13.0.3",
    "prettier": "2.7.1",
    "sass": "^1.54.5",
    "textlint": "^12.2.1",
    "textlint-rule-preset-ja-spacing": "2.2.0",
    "textlint-rule-preset-japanese": "7.0.0",
    "typescript": "4.7.4",
    "webpack-cli": "^4.10.0"
  },
  "keywords": [
    "gatsby",
    "gatstrap",
    "starter"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "npm run lint:textfix"
    ]
  },
  "main": "n/a",
  "scripts": {
    "build": "gatsby build",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.+(js|json|md|tsx)\" --ignore-path .gitignore",
    "lint": "eslint --fix --ext .js,.jsx --ignore-path .gitignore .",
    "lint:text": "textlint src/pages/**/index.md",
    "lint:textfix": "textlint --fix src/pages/**/index.md",
    "test": "prettier --write \"**/*.+(js|jsx|json|css|scss)\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
