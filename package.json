  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "@fontsource/noto-serif-jp": "^5.0.7",
    "@fortawesome/fontawesome-svg-core": "6.4.2",
    "@fortawesome/free-brands-svg-icons": "6.4.2",
    "@fortawesome/free-solid-svg-icons": "6.4.2",
    "@fortawesome/react-fontawesome": "0.2.0",
    "animate.css": "4.1.1",
    "bootstrap": "^5.3.2",
    "emergence.js": "1.1.2",
    "filters.css": "^1.0.0",
    "font-awesome": "4.7.0",
    "framer-motion": "^10.16.5",
    "gatsby": "^5.12.9",
    "gatsby-image": "3.7.1",
    "gatsby-link": "^5.12.1",
    "gatsby-plugin-canonical-urls": "^5.12.0",
    "gatsby-plugin-catch-links": "5.12.0",
    "gatsby-plugin-google-adsense": "^1.1.3",
    "gatsby-plugin-google-analytics": "^5.12.0",
    "gatsby-plugin-htaccess": "^1.4.0",
    "gatsby-plugin-image": "^3.12.3",
    "gatsby-plugin-manifest": "^5.12.3",
    "gatsby-plugin-netlify": "5.1.1",
    "gatsby-plugin-nprogress": "^5.12.0",
    "gatsby-plugin-offline": "6.12.3",
    "gatsby-plugin-react-helmet": "6.12.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sass": "^6.12.3",
    "gatsby-plugin-sharp": "^5.12.3",
    "gatsby-plugin-sitemap": "^6.12.3",
    "gatsby-plugin-twitter": "^5.12.3",
    "gatsby-plugin-typegen": "^3.1.0",
    "gatsby-plugin-typescript": "^5.12.1",
    "gatsby-remark-copy-linked-files": "6.12.0",
    "gatsby-remark-images": "7.12.3",
    "gatsby-remark-prismjs": "7.12.0",
    "gatsby-remark-responsive-iframe": "6.12.0",
    "gatsby-remark-smartypants": "6.12.0",
    "gatsby-source-filesystem": "^5.12.1",
    "gatsby-transformer-remark": "6.12.3",
    "gatsby-transformer-sharp": "^5.12.3",
    "got": "^13.0.0",
    "jquery": "3.7.1",
    "modern-normalize": "2.0.0",
    "popper.js": "1.16.1",
    "postcss": "^8.4.31",
    "prismjs": "1.29.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "6.1.0",
    "react-intersection-observer": "^9.5.3",
    "react-slick": "^0.29.0",
    "sharp": "^0.34.4",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.5.1",
    "@types/react-helmet": "6.1.9",
    "@typescript-eslint/eslint-plugin": "6.11.0",
    "@typescript-eslint/parser": "6.11.0",
    "babel-eslint": "10.1.0",
    "eslint": "8.54.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "gh-pages": "^6.1.0",
    "husky": "8.0.3",
    "lint-staged": "15.1.0",
    "prettier": "3.1.0",
    "sass": "^1.69.5",
    "textlint": "^13.4.0",
    "textlint-rule-preset-ja-spacing": "2.3.0",
    "textlint-rule-preset-japanese": "8.0.0",
    "typescript": "5.2.2",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "gatsby",
    "gatstrap",
    "starter"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "npm run lint:textfix"
    ]
  },
  "main": "n/a",
  "scripts": {
    "build": "gatsby build",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.+(js|json|md|tsx)\" --ignore-path .gitignore",
    "lint": "eslint --fix --ext .js,.jsx --ignore-path .gitignore .",
    "lint:text": "textlint src/pages/**/index.md",
    "lint:textfix": "textlint --fix src/pages/**/index.md",
    "test": "prettier --write \"**/*.+(js|jsx|json|css|scss)\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
