{
  "name": "gatsby-starter-bootstrap",
  "description": "Simple starter for Gatsby",
  "version": "3.0.0",
  "author": "Futoshi Iwashita <jaxx2104@gmail.com>",
  "dependencies": {
    "@fontsource/noto-sans-jp": "^4.3.0",
    "@fontsource/noto-serif-jp": "^4.3.0",
    "@fontsource/open-sans": "^4.3.0",
    "@fontsource/shippori-mincho-b1": "^4.3.0",
    "@fortawesome/fontawesome-svg-core": "1.2.35",
    "@fortawesome/free-brands-svg-icons": "5.15.3",
    "@fortawesome/free-solid-svg-icons": "5.15.3",
    "@fortawesome/react-fontawesome": "0.1.14",
    "animate.css": "4.1.1",
    "bootstrap": "5.0.0",
    "emergence.js": "1.1.2",
    "filters.css": "^1.0.0",
    "font-awesome": "4.7.0",
    "framer-motion": "^4.1.13",
    "gatsby": "3.4.2",
    "gatsby-image": "3.4.0",
    "gatsby-link": "3.4.0",
    "gatsby-plugin-catch-links": "3.4.0",
    "gatsby-plugin-image": "^1.4.1",
    "gatsby-plugin-manifest": "3.4.0",
    "gatsby-plugin-netlify": "3.4.0",
    "gatsby-plugin-offline": "4.4.0",
    "gatsby-plugin-react-helmet": "4.4.0",
    "gatsby-plugin-sass": "^4.4.0",
    "gatsby-plugin-sharp": "^3.4.2",
    "gatsby-plugin-sitemap": "4.0.0",
    "gatsby-plugin-twitter": "3.4.0",
    "gatsby-plugin-typegen": "^2.2.4",
    "gatsby-plugin-typescript": "^3.4.0",
    "gatsby-remark-copy-linked-files": "4.1.0",
    "gatsby-remark-images": "5.1.0",
    "gatsby-remark-prismjs": "5.1.0",
    "gatsby-remark-responsive-iframe": "4.1.0",
    "gatsby-remark-smartypants": "4.1.0",
    "gatsby-source-filesystem": "^3.4.0",
    "gatsby-source-instagram": "^0.9.0",
    "gatsby-transformer-remark": "4.1.0",
    "gatsby-transformer-sharp": "^3.4.0",
    "jquery": "3.6.0",
    "modern-normalize": "1.1.0",
    "popper.js": "1.16.1",
    "prismjs": "1.23.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-helmet": "6.1.0",
    "react-intersection-observer": "^8.31.1",
    "react-slick": "^0.28.1",
    "sass": "1.32.12",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@types/react-helmet": "6.1.1",
    "@typescript-eslint/eslint-plugin": "4.22.1",
    "@typescript-eslint/parser": "4.22.1",
    "babel-eslint": "10.1.0",
    "eslint": "7.26.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "3.4.0",
    "eslint-plugin-react": "7.23.2",
    "eslint-plugin-react-hooks": "4.2.0",
    "gh-pages": "3.1.0",
    "husky": "6.0.0",
    "lint-staged": "11.0.0",
    "prettier": "2.2.1",
    "textlint": "11.9.0",
    "textlint-rule-preset-ja-spacing": "2.1.1",
    "textlint-rule-preset-japanese": "6.0.1",
    "typescript": "4.2.4",
    "webpack-cli": "^4.7.0"
  },
  "keywords": [
    "gatsby",
    "gatstrap",
    "starter"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "npm run lint:textfix"
    ]
  },
  "main": "n/a",
  "scripts": {
    "build": "gatsby build",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.+(js|json|md|tsx)\" --ignore-path .gitignore",
    "lint": "eslint --fix --ext .js,.jsx --ignore-path .gitignore .",
    "lint:text": "textlint src/pages/**/index.md",
    "lint:textfix": "textlint --fix src/pages/**/index.md",
    "test": "prettier --write \"**/*.+(js|jsx|json|css|scss)\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
